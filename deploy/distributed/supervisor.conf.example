[supervisord]
nodaemon=true
umask=0077
logfile=%(ENV_FLIGHT_PROJECT_ROOT)s/runtime/distributed/supervisord.log
pidfile=%(ENV_FLIGHT_PROJECT_ROOT)s/runtime/distributed/supervisord.pid
childlogdir=%(ENV_FLIGHT_PROJECT_ROOT)s/runtime/distributed

[unix_http_server]
file=%(ENV_FLIGHT_PROJECT_ROOT)s/runtime/distributed/supervisor.sock
chmod=0600

[rpcinterface:supervisor]
supervisor.rpcinterface_factory=supervisor.rpcinterface:make_main_rpcinterface

[supervisorctl]
serverurl=unix://%(ENV_FLIGHT_PROJECT_ROOT)s/runtime/distributed/supervisor.sock

[program:flight-web-a]
directory=%(ENV_FLIGHT_PROJECT_ROOT)s
command=%(ENV_FLIGHT_PROJECT_ROOT)s/.venv/bin/python -m gunicorn -c deploy/distributed/gunicorn.conf.py --bind 127.0.0.1:7101 deploy.distributed.wsgi:create_production_app()
environment=FLIGHT_WEB_INSTANCE="web-a",FLIGHT_RUNTIME_ROOT="%(ENV_FLIGHT_PROJECT_ROOT)s/runtime/web-a"
priority=20
autostart=true
autorestart=unexpected
startsecs=5
startretries=5
stopasgroup=true
killasgroup=true
stopsignal=TERM
stopwaitsecs=40
stdout_logfile=%(ENV_FLIGHT_PROJECT_ROOT)s/runtime/distributed/web-a.log
stderr_logfile=%(ENV_FLIGHT_PROJECT_ROOT)s/runtime/distributed/web-a-error.log

[program:flight-web-b]
directory=%(ENV_FLIGHT_PROJECT_ROOT)s
command=%(ENV_FLIGHT_PROJECT_ROOT)s/.venv/bin/python -m gunicorn -c deploy/distributed/gunicorn.conf.py --bind 127.0.0.1:7102 deploy.distributed.wsgi:create_production_app()
environment=FLIGHT_WEB_INSTANCE="web-b",FLIGHT_RUNTIME_ROOT="%(ENV_FLIGHT_PROJECT_ROOT)s/runtime/web-b"
priority=20
autostart=true
autorestart=unexpected
startsecs=5
startretries=5
stopasgroup=true
killasgroup=true
stopsignal=TERM
stopwaitsecs=40
stdout_logfile=%(ENV_FLIGHT_PROJECT_ROOT)s/runtime/distributed/web-b.log
stderr_logfile=%(ENV_FLIGHT_PROJECT_ROOT)s/runtime/distributed/web-b-error.log

[program:flight-nginx]
directory=%(ENV_FLIGHT_PROJECT_ROOT)s
command=/usr/sbin/nginx -p %(ENV_FLIGHT_PROJECT_ROOT)s/runtime/nginx/ -c %(ENV_FLIGHT_PROJECT_ROOT)s/runtime/nginx/nginx.conf
priority=30
autostart=true
autorestart=unexpected
startsecs=5
startretries=5
stopasgroup=true
killasgroup=true
stopsignal=TERM
stdout_logfile=%(ENV_FLIGHT_PROJECT_ROOT)s/runtime/distributed/nginx.log
stderr_logfile=%(ENV_FLIGHT_PROJECT_ROOT)s/runtime/distributed/nginx-error.log

[program:flight-publisher]
directory=%(ENV_FLIGHT_PROJECT_ROOT)s
command=%(ENV_FLIGHT_PROJECT_ROOT)s/.venv/bin/python -m scripts.durable_prediction publisher
environment=PYTHONPATH="%(ENV_FLIGHT_PROJECT_ROOT)s:%(ENV_FLIGHT_PROJECT_ROOT)s/generated"
priority=15
autostart=true
autorestart=unexpected
startsecs=5
startretries=5
stopasgroup=true
killasgroup=true
stdout_logfile=%(ENV_FLIGHT_PROJECT_ROOT)s/runtime/distributed/publisher.log
stderr_logfile=%(ENV_FLIGHT_PROJECT_ROOT)s/runtime/distributed/publisher-error.log

[program:flight-executor-a]
directory=%(ENV_FLIGHT_PROJECT_ROOT)s
command=%(ENV_FLIGHT_PROJECT_ROOT)s/.venv/bin/python -m scripts.durable_prediction executor --owner executor-a --lease 30
environment=PYTHONPATH="%(ENV_FLIGHT_PROJECT_ROOT)s:%(ENV_FLIGHT_PROJECT_ROOT)s/generated"
priority=15
autostart=true
autorestart=unexpected
startsecs=5
startretries=5
stopasgroup=true
killasgroup=true
stdout_logfile=%(ENV_FLIGHT_PROJECT_ROOT)s/runtime/distributed/executor-a.log
stderr_logfile=%(ENV_FLIGHT_PROJECT_ROOT)s/runtime/distributed/executor-a-error.log

[program:flight-reconcile]
directory=%(ENV_FLIGHT_PROJECT_ROOT)s
command=%(ENV_FLIGHT_PROJECT_ROOT)s/.venv/bin/python -m scripts.durable_prediction reconcile
environment=PYTHONPATH="%(ENV_FLIGHT_PROJECT_ROOT)s:%(ENV_FLIGHT_PROJECT_ROOT)s/generated"
priority=15
autostart=true
autorestart=unexpected
startsecs=5
startretries=5
stopasgroup=true
killasgroup=true
stdout_logfile=%(ENV_FLIGHT_PROJECT_ROOT)s/runtime/distributed/reconcile.log
stderr_logfile=%(ENV_FLIGHT_PROJECT_ROOT)s/runtime/distributed/reconcile-error.log
